    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.10",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.2",
    "eslint": "^8.57.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
