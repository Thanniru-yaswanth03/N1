# ═══════════════════════════════════════════════════════════════════════════════
# N1 Platform — Environment Configuration Template
# All defaults are pre-configured for 100% ZERO-COST local execution.
# Copy this file to .env before starting the application.
# ═══════════════════════════════════════════════════════════════════════════════

# ── General Server Configuration ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# ── Database (MongoDB) ────────────────────────────────────────────────────────
# Default: Local MongoDB instance (Zero Cost)
# Production: Can use MongoDB Atlas M0 Free Tier (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/n1_drop

# ── Storage Driver Configuration ──────────────────────────────────────────────
# Supported drivers: 'local' (default) or 's3' (for Cloudflare R2 / Backblaze free tier)
STORAGE_DRIVER=local

# Local storage configuration (used when STORAGE_DRIVER=local)
# Files are written strictly to an isolated private directory outside the public web root
LOCAL_STORAGE_PATH=./storage/drops

# Optional S3/R2 configuration (used only when STORAGE_DRIVER=s3)
# Works out of the box with Cloudflare R2 (10 GB free, $0 egress fees)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_NAME=n1-drops
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ── Application Constraints & Limits (Must match specification) ───────────────
# Max file size: 50 MB in bytes (50 * 1024 * 1024)
MAX_FILE_SIZE_BYTES=52428800

# Max aggregate drop size: 200 MB in bytes (200 * 1024 * 1024)
MAX_TOTAL_DROP_SIZE_BYTES=209715200

# Max files per single drop
MAX_FILES_PER_DROP=10

# Max characters in plain text mode
MAX_TEXT_CHARACTERS=10000

# ── Security & Cryptography ───────────────────────────────────────────────────
# Secret used for signing temporary unlocked drop session tokens (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_char_hex_secret_in_production

# Pepper used for password hashing (optional extra layer of server-side entropy)
PASSWORD_PEPPER=replace_with_random_pepper_secret

# ── Expiration & Worker Configuration ─────────────────────────────────────────
# Interval in seconds between background cleanup sweeps for expired files
CLEANUP_INTERVAL_SECONDS=60

# Grace period in seconds to retain expired drop tombstones before deleting metadata
TOMBSTONE_RETENTION_SECONDS=86400

# ── Rate Limiting (express-rate-limit) ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=15
UNLOCK_RATE_LIMIT_WINDOW_MS=300000
UNLOCK_RATE_LIMIT_MAX=5
